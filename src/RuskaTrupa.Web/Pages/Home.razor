    private async Task SubmitBid()
    {
        await SubmitBidAmount(bidInput ?? MinimumHumanBid());
    }

    private async Task SubmitBidAmount(int? requestedAmount)
    {
        var legalBids = HumanBidActions()
            .Where(action => action.Amount is not null)
            .ToArray();

        if (legalBids.Length == 0)
        {
            if (bidInput > 120)
            {
                bidError = Text["BidMarriageRequiredError"];
            }

            return;
        }

        var requested = requestedAmount ?? legalBids[0].Amount!.Value;
        var minimum = legalBids.Min(action => action.Amount!.Value);
        if (requested < minimum)
        {
            bidInputMinimum = minimum;
            bidInput = minimum;
            bidError = MinimumBidError(minimum);
            EnsureBidMarriageSuit();
            return;
        }

        bidInput = requested;
        if (requested > 120)
        {
            EnsureBidMarriageSuit();
            if (HumanBidMarriageSuits().Count == 0)
            {
                bidError = Text["BidMarriageRequiredError"];
                return;
            }

            if (bidMarriageSuit is null)
            {
                bidError = Text["BidMarriageChooseSuitError"];
                return;
            }
        }

        var action = legalBids.FirstOrDefault(action => action.Amount!.Value >= requested
                && (action.Amount <= 120 || action.MarriageSuit == bidMarriageSuit))
            ?? legalBids.FirstOrDefault(action => action.Amount!.Value >= requested)
            ?? legalBids[^1];
        if (requested > 120 && action.Amount <= 120)
        {
            bidError = Text["BidMarriageRequiredError"];
            return;
        }

        bidError = null;
        bidInput = action.Amount;
        await ApplyHumanAction(action);
    }

