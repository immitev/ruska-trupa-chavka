    private static IReadOnlyList<Card> SortHandForDisplay(IReadOnlyList<Card> cards)
    {
        var suitOrder = AlternatingSuitOrder(cards.Select(card => card.Suit).Distinct()).ToArray();
        var suitRanks = suitOrder
            .Select((suit, index) => new { suit, index })
            .ToDictionary(pair => pair.suit, pair => pair.index);

        return cards
            .OrderBy(card => suitRanks[card.Suit])
            .ThenBy(card => RankSortValue(card.Rank))
            .ToArray();
    }

    private static IEnumerable<Suit> AlternatingSuitOrder(IEnumerable<Suit> suits)
    {
        var present = suits.ToHashSet();
        var black = new Queue<Suit>(new[] { Suit.Clubs, Suit.Spades }.Where(present.Contains));
        var red = new Queue<Suit>(new[] { Suit.Diamonds, Suit.Hearts }.Where(present.Contains));
        bool? lastWasRed = null;

        while (black.Count > 0 || red.Count > 0)
        {
            var takeRed = ShouldTakeRedSuit(red.Count, black.Count, lastWasRed);
            if (takeRed && red.Count > 0)
            {
                yield return red.Dequeue();
                lastWasRed = true;
                continue;
            }

            if (black.Count > 0)
            {
                yield return black.Dequeue();
                lastWasRed = false;
                continue;
            }

            yield return red.Dequeue();
            lastWasRed = true;
        }
    }

    private static bool ShouldTakeRedSuit(int redCount, int blackCount, bool? lastWasRed)
    {
        if (redCount == 0)
        {
            return false;
        }

        if (blackCount == 0)
        {
            return true;
        }

        if (lastWasRed is true)
        {
            return false;
        }

        if (lastWasRed is false)
        {
            return true;
        }

        return redCount > blackCount;
    }

