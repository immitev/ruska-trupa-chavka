    }

    private async Task LoadBotNamesAsync()
    {
        var json = await Js.InvokeAsync<string?>("localStorage.getItem", BotNameStorageKey);
        if (string.IsNullOrWhiteSpace(json))
        {
            foreach (var player in game.Players.Where(player => player.Kind == PlayerKind.Bot))
            {
                botNames[player.Id] = SuggestedPersonaName(player.Id);
            }
            return;
        }

        var saved = System.Text.Json.JsonSerializer.Deserialize<Dictionary<PlayerId, string>>(json);
        if (saved is null)
        {
            return;
        }

        foreach (var player in game.Players.Where(player => player.Kind == PlayerKind.Bot))
        {
            botNames[player.Id] = saved.TryGetValue(player.Id, out var name) && !string.IsNullOrWhiteSpace(name)
                ? name.Trim()
                : SuggestedPersonaName(player.Id);
        }
    }

