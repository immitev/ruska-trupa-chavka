@page "/play"
@page "/play/index.html"
@inject CultureState Text
@inject IJSRuntime Js

<PageTitle>@Text["AppName"]</PageTitle>

@if (!isReady)
{
    <main class="game-shell">
        <section class="table-panel">
            <h1>@Text["AppName"]</h1>
            <p>@Text["LoadingGame"]</p>
        </section>
    </main>
    return;
}

<main class="game-shell">
    <section class="table-panel">
        <div class="game-board-layout">
            <aside class="game-rail" aria-label="@Text["GameSetup"]">
                <div class="rail-brand">
                    <strong>@Text["AppName"]</strong>
                    <div class="rail-tools">
                        <select class="language-select" aria-label="@Text["Language"]" value="@Text.CurrentCulture.TwoLetterISOLanguageName" @onchange="OnCultureChanged">
                            <option value="bg">БГ</option>
                            <option value="en">EN</option>
                        </select>
                        <button class="help-button" type="button" aria-label="@Text["Rules"]" title="@Text["Rules"]" @onclick="ShowRules">?</button>
                    </div>
                </div>

                <div class="rail-actions">
                    <button class="btn btn-primary btn-sm" @onclick="NewDeal">@Text["NewGame"]</button>
                    @if (CanEnableHumanAutoplay())
                    {
                        <button class="btn btn-secondary btn-sm" type="button" @onclick="EnableHumanAutoplayAsync">@Text["AutoplayHand"]</button>
                    }
                    @if (!pendingResignConfirmation && HumanResignAction() is not null)
                    {
                        <button class="btn btn-outline-danger btn-sm" type="button" @onclick="ShowResignConfirmation">
                            @Text["ResignHand"]
                        </button>
                    }
                </div>

                <section class="table-score-zone rail-score-zone" aria-label="@Text["CurrentScore"]">
                    @foreach (var player in game.Players)
                    {
                        <span class="@ScoreNameClass(player)">@PlayerName(player)</span>
                        <strong class="@ScoreValueClass(player)">@game.GameScores[player.Id]</strong>
                    }
                </section>

                @if (IsReplayMode)
                {
                    <section class="replay-panel" aria-label="@Text["Replay"]">
                        <div class="replay-status">
                            <strong>@Text["Replay"]</strong>
                            <span>@ReplayStepLabel()</span>
                        </div>
                        <div class="replay-actions">
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@(replayStep <= 0)" @onclick="PreviousReplayStep">@Text["Previous"]</button>
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@(replayStep >= replayActions.Count)" @onclick="NextReplayStep">@Text["Next"]</button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ExitReplay">@Text["ExitReplay"]</button>
                        </div>
                        <span class="replay-current-action">@ReplayCurrentActionLabel()</span>
                    </section>
                }

                <section class="@PhaseControlsClass()">
                    @foreach (var action in HumanNonCardActions())
                    {
                        <button class="@ActionButtonClass(action)" type="button" aria-label="@ActionLabel(action)" @onclick="() => ApplyHumanAction(action)">
                            @ActionLabel(action)
                        </button>
                    }
                </section>
            </aside>

        <section class="@PlayAreaClass()" aria-label="@Text["GameTable"]">
            <section class="table-score-zone table-score-zone-table" aria-label="@Text["CurrentScore"]">
                @foreach (var player in game.Players)
                {
                    <span class="@ScoreNameClass(player)">@PlayerName(player)</span>
                    <strong class="@ScoreValueClass(player)">@game.GameScores[player.Id]</strong>
                }
            </section>

            @if (game.Phase != GamePhase.GameOver)
            {
                @OpponentSeat(PlayerId.Second, "table-seat seat-top")
                @OpponentSeat(PlayerId.Third, "table-seat seat-left")
            }

            <div class="table-center">
                @if (game.Phase == GamePhase.GameOver)
                {
                    <div class="game-over-center" role="status" aria-live="polite">
                        <div class="winner-celebration">
                            <span class="winner-spark winner-spark-left"></span>
                            <span class="winner-spark winner-spark-right"></span>
                            <small>@Text["GameWinnerAnnouncement"]</small>
                            <strong>@PlayerName(Winner())</strong>
                        </div>
                        <button class="table-result-button play-again-button" type="button" @onclick="PlayAgainAsync">
                            @Text["PlayAgain"]
                        </button>
                    </div>
                }
                else
                {
                    @if (pendingResignConfirmation)
                    {
                        <div class="resign-confirm-panel" role="alertdialog" aria-live="polite">
                            <strong>@SetupReviewLabel("Искаш да се откажеш?", "Resign this hand?")</strong>
                            <span>@SetupReviewLabel("Опонентите ти ще получат по 25 точки.", "Your opponents will receive 25 points each.")</span>
                            <div class="resign-confirm-actions">
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="CancelResignConfirmation">
                                    @SetupReviewLabel("Продължи играта", "Continue game")
                                </button>
                                <button class="btn btn-danger btn-sm" type="button" @onclick="ConfirmResignAsync">
                                    @SetupReviewLabel("Да, отказвам се", "Yes, resign")
                                </button>
                            </div>
                        </div>
                    }
                    else if (ShouldShowTalonExchangePreview())
                    {
                        <div class="@TalonExchangePreviewClass()" aria-label="@Text["Talon"]">
                        @if (ShouldShowTalonExchangeTitle())
                        {
                            <strong class="talon-exchange-title">
                                <span>@TalonExchangeTitleLabel()</span>
                                <span class="@TalonExchangeTitleTrumpClass()">@TalonExchangeTitleTrump()</span>
                            </strong>
                        }
                        <div class="@TalonExchangeCardsClass()">
                            @foreach (var item in TalonExchangeItems())
                            {
                                <article class="@TalonExchangeCardClass(item)">
                                    @CardView(item.Card, "mini-card")
                                    @if (!string.IsNullOrWhiteSpace(item.Label) && !ShouldUseDirectedTalonCards())
                                    {
                                        <span>@item.Label</span>
                                    }
                                </article>
                            }
                        </div>
                        @if (awaitingTalonExchangeConfirmation)
                        {
                            <button class="btn btn-success btn-sm talon-confirm-button" type="button" @onclick="ConfirmTalonExchangePreviewAsync">
                                @Text["PlayOn"]
                            </button>
                        }
                        @if (awaitingHumanPlayStartConfirmation)
                        {
                            <div class="talon-review-actions">
                                <div class="talon-review-secondary-actions">
                                    <button class="btn btn-secondary btn-sm talon-review-subtle-button" type="button" @onclick="StepBackHumanExchangeAsync">
                                        @SetupReviewLabel("Назад", "Back")
                                    </button>
                                </div>
                                <button class="btn btn-success btn-sm talon-confirm-button" type="button" @onclick="ConfirmHumanExchangeAsync">
                                    @Text["PlayOn"]
                                </button>
                            </div>
                        }
                        </div>
                    }
                    else if (IsHumanBidding())
                    {
                        <div class="bid-picker" aria-label="@Text["Bidding"]">
                        @if (HumanBidActions().Any(action => action.Amount is null))
                        {
                            <button class="btn btn-secondary" type="button" @onclick="PassBid">@Text["Pass"]</button>
                        }
                        @if (QuickBidOptions().Count > 0)
                        {
                            <div class="bid-quick-picker">
                                @foreach (var amount in QuickBidOptions())
                                {
                                    <button class="bid-quick-button" type="button" @onclick="() => SubmitBidAmount(amount)">
                                        @amount
                                    </button>
                                }
                            </div>
                        }
                        @if (HumanBidActions().Any(action => action.Amount is not null))
                        {
                            <input @ref="bidInputElement" type="number" min="@MinimumHumanBid()" step="1" value="@BidInputValue()" @oninput="OnBidInputChanged" @onkeydown="OnBidInputKeyDown" autofocus />
                        }
                        @if (HumanBidActions().Any(action => action.Amount is not null) && BidRequiresMarriageSuit())
                        {
                            <div class="bid-marriage-picker" aria-label="@Text["BidMarriageSuit"]">
                                @foreach (var suit in HumanBidMarriageSuits())
                                {
                                    <button class="@BidMarriageButtonClass(suit)" type="button" title="@SuitName(suit)" @onclick="() => SelectBidMarriageSuit(suit)">
                                        @SuitSymbol(suit)
                                    </button>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(bidError))
                        {
                            <span class="bid-error">@bidError</span>
                        }
                        </div>
                    }
                    else if (game.Phase == GamePhase.PassCards && CurrentPassRecipient() is not null)
                    {
                        <div class="pass-target table-pass-target">@PassTargetLabel()</div>
                        @if (CanStepBackHumanExchange())
                        {
                            <button class="btn btn-secondary btn-sm talon-review-subtle-button" type="button" @onclick="StepBackHumanExchangeAsync">
                                @SetupReviewLabel("Назад", "Back")
                            </button>
                        }
                    }
                    else if (game.Phase == GamePhase.ChooseTrump && HumanTrumpActions().Count > 0)
                    {
                        <div class="trump-picker" aria-label="@Text["ChooseTrump"]">
                        <h2>@Text["ChooseTrump"]</h2>
                        <div class="trump-options">
                            @foreach (var action in HumanTrumpActions())
                            {
                                <button class="@TrumpButtonClass(action.Trump)" type="button" aria-label="@ActionLabel(action)" @onclick="() => ApplyHumanAction(action)">
                                    <strong>@TrumpSymbol(action.Trump)</strong>
                                </button>
                            }
                        </div>
                        </div>
                    }
                    else if (game.Phase == GamePhase.ScoringHand && HumanSettleAction() is { } settleAction)
                    {
                        @if (HumanCompletedContract())
                        {
                            <div class="contract-success-toast" role="status">
                                <span class="celebration-spark spark-left"></span>
                                <strong>@Text["ContractSuccess"]</strong>
                                <span class="celebration-score">@game.HandScores[PlayerId.First]/@game.WinningBid</span>
                                <span class="celebration-spark spark-right"></span>
                            </div>
                        }
                        <div class="table-result-panel">
                        <div class="table-result-summary">
                            @foreach (var player in game.Players)
                            {
                                <span class="@HandResultClass(player.Id)">
                                    @PlayerName(player): @SettlementDelta(player.Id)
                                </span>
                            }
                        </div>
                        <button class="table-result-button" type="button" @onclick="() => ApplyHumanAction(settleAction)">
                            @Text["SettleHand"]
                        </button>
                        @if (CanStartReplay())
                        {
                            <button class="table-review-button" type="button" @onclick="StartReplay">
                                @Text["ReviewHand"]
                            </button>
                        }
                        </div>
                    }
                    else if (game.Phase == GamePhase.RevealTalon || isHumanTalonCollecting)
                    {
                        <div class="@HumanTalonRevealClass()">
                        @foreach (var card in game.Talon)
                        {
                            @CardView(card, "mini-card")
                        }
                        </div>
                    }

                    @if (VisibleTableTrick().Count > 0)
                    {
                        <div class="@CurrentTrickCardsClass()" aria-label="@Text["CurrentTrick"]">
                        @foreach (var played in VisibleTableTrick())
                        {
                            <article class="@PlayedCardClass(played.Player)">
                                @if (MarriageCardPreviewFor(played.Player) is { } marriagePreview)
                                {
                                    <div class="marriage-card-preview">
                                        @CardView(new Card(marriagePreview.Suit, Rank.Queen), "mini-card")
                                        @CardView(new Card(marriagePreview.Suit, Rank.King), "mini-card")
                                    </div>
                                }
                                else
                                {
                                    @CardView(played.Card, "mini-card")
                                }
                            </article>
                        }
                        </div>
                    }
                }
            </div>

            @if (ShouldShowTalonZone())
            {
                <aside class="talon-zone" aria-label="@Text["Talon"]">
                    <div class="talon-stack">
                        @if (ShouldShowOpenTalonCards())
                        {
                            @foreach (var card in TalonZoneCards())
                            {
                                @CardView(card, "mini-card")
                            }
                        }
                        else
                        {
                            @for (var index = 0; index < game.Talon.Count; index++)
                            {
                                <span class="card-back talon-back" style="--card-index: @index"></span>
                            }
                        }
                    </div>
                </aside>
            }

            @if (game.Phase is not (GamePhase.Bidding or GamePhase.GameOver))
            {
                <aside @key="contractAnimationKey" class="@ContractZoneClass()" aria-label="@Text["Contract"]">
                    <span class="contract-bid">
                        @if (game.Bidder is { } bidder)
                        {
                            <em>@PlayerName(bidder)</em>
                        }
                        <small>@Text["Bid"]</small>
                        <strong>@(game.WinningBid?.ToString() ?? Text["NoBid"])</strong>
                    </span>
                    <span class="contract-trump">
                        <small>@Text["Trump"]</small>
                        <strong class="@TrumpContractClass()">@TrumpContractLabel()</strong>
                    </span>
                </aside>
            }

            @if (game.Phase != GamePhase.GameOver && LastTrickForZone() is { } lastTrick)
            {
                <aside class="last-trick-zone" aria-label="@Text["LastTrick"]">
                    <span class="zone-label">@Text["LastTrick"]</span>
                    <strong>@PlayerName(game.Players.Single(player => player.Id == lastTrick.Winner))</strong>
                    <div class="history-cards">
                        @foreach (var played in lastTrick.Cards)
                        {
                            @CardView(played.Card, "micro-card")
                        }
                    </div>
                </aside>
            }

            @if (game.Phase != GamePhase.GameOver)
            {
            <section class="human-seat" aria-label="@Text["YourHand"]">
                <div class="human-seat-info">
                    <strong>@PlayerName(PlayerId.First)</strong>
                    @if (MarriageFlashLabel(PlayerId.First) is { } humanFlash)
                    {
                        <span class="marriage-flash">@humanFlash</span>
                    }
                    @if (MarriageBonusLabel(PlayerId.First) is { } humanBonus)
                    {
                        <span class="bonus-badge">@humanBonus</span>
                    }
                    @if (HumanTrupaAction() is { } trupaAction)
                    {
                        <button class="trupa-table-button" type="button" title="@Text["SignalTrupaHint"]" @onclick="() => ApplyHumanAction(trupaAction)">
                            <span aria-hidden="true">📣</span>
                            @Text["SignalTrupa"]
                        </button>
                    }
                </div>
                <div class="human-card-row">
                    <div class="hand">
                        @foreach (var card in HumanHand())
                        {
                            <button class="@CardClass(card)" type="button" aria-label="@HandCardLabel(card)" title="@CardLabel(card)" disabled="@(!CanUseCard(card))" @onclick="() => UseHumanCard(card)">
                                @CardInner(card)
                            </button>
                        }
                    </div>
                    @if (PendingPassedCardFor(PlayerId.First) is { } humanPendingCard)
                    {
                        <div class="pending-passed-card pending-passed-card-human">
                            @CardView(humanPendingCard, "mini-card")
                        </div>
                    }
                    @TrickPile(PlayerId.First, "trick-pile-human")
                </div>
            </section>
            }
        </section>
        </div>

    </section>

    @if (rulesVisible)
    {
        <div class="modal-backdrop rules-backdrop" role="presentation" @onclick="HideRules">
            <section class="rules-modal" role="dialog" aria-modal="true" aria-labelledby="rules-title" @onclick:stopPropagation>
                <header>
                    <div class="rules-title-block">
                        <span>@Text["AppName"]</span>
                        <h2 id="rules-title">@Text["Rules"]</h2>
                    </div>
                    <button class="modal-close-button" type="button" aria-label="@Text["Close"]" @onclick="HideRules">×</button>
                </header>
                <div class="rules-content">
                    @foreach (var item in RulesText().Select((rule, index) => new { Rule = rule, Number = index + 1 }))
                    {
                        <article class="rule-card">
                            <span class="rule-number">@item.Number</span>
                            <div>
                                <h3>@RuleTitle(item.Rule)</h3>
                                <p>@RuleBody(item.Rule)</p>
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>
    }

    @if (newGameSetupVisible)
    {
        <div class="modal-backdrop setup-backdrop" role="presentation" @onclick="CancelNewGameSetup">
            <section class="rules-modal setup-modal" role="dialog" aria-modal="true" aria-labelledby="setup-title" @onclick:stopPropagation>
                <header class="setup-modal-header">
                    <div class="setup-title-block">
                        <span class="setup-kicker">@Text["AppName"]</span>
                        <h2 id="setup-title">@Text["NewGameSetup"]</h2>
                    </div>
                    <div class="setup-header-tools">
                        <select class="language-select setup-language-select" aria-label="@Text["Language"]" value="@Text.CurrentCulture.TwoLetterISOLanguageName" @onchange="OnCultureChanged">
                            <option value="bg">БГ</option>
                            <option value="en">EN</option>
                        </select>
                        <button class="help-button" type="button" aria-label="@Text["Rules"]" title="@Text["Rules"]" @onclick="ShowRules">?</button>
                        @if (CanCancelNewGameSetup())
                        {
                            <button class="modal-close-button" type="button" aria-label="@Text["Close"]" @onclick="CancelNewGameSetup">×</button>
                        }
                    </div>
                </header>
                <div class="setup-modal-content">
                    <div class="setup-tabs" role="tablist" aria-label="@Text["GameSetup"]">
                        <button class="@SetupTabClass(0)" type="button" role="tab" aria-selected="@(setupTabIndex == 0)" @onclick="() => SelectSetupTab(0)">
                            <strong>@Text["YourName"]</strong>
                        </button>
                        <button class="@SetupTabClass(1)" type="button" role="tab" aria-selected="@(setupTabIndex == 1)" @onclick="() => SelectSetupTab(1)">
                            <strong>@Text["OpponentOne"]</strong>
                        </button>
                        <button class="@SetupTabClass(2)" type="button" role="tab" aria-selected="@(setupTabIndex == 2)" @onclick="() => SelectSetupTab(2)">
                            <strong>@Text["OpponentTwo"]</strong>
                        </button>
                    </div>

                    <div class="setup-tab-page">
                        @if (setupTabIndex == 0)
                        {
                            <section class="setup-player-card" aria-label="@Text["YourName"]">
                                <h3>@Text["YourName"]</h3>
                                <label>
                                    <span>@Text["YourName"]</span>
                                    <input value="@humanName" @onchange="OnHumanNameChanged" maxlength="24" autocomplete="name" />
                                </label>
                            </section>
                        }
                        else
                        {
                            var playerId = setupTabIndex == 1 ? PlayerId.Second : PlayerId.Third;
                            <section class="setup-opponent-card setup-tab-opponent-card" aria-label="@PlayerSetupLabel(playerId)">
                                <h3>@PlayerSetupLabel(playerId)</h3>
                                <label>
                                    <span>@Text["OpponentName"]</span>
                                    <input value="@BotNameValue(playerId)" @onchange="args => SetBotName(playerId, args.Value?.ToString())" maxlength="24" placeholder="@SuggestedPersonaName(playerId)" />
                                </label>
                                <label>
                                    <span>@Text["PlayStyle"]</span>
                                    <select value="@PersonaKey(playerId)" @onchange="args => SetPersona(playerId, args.Value?.ToString())" aria-label="@Text["PlayStyle"]">
                                        @foreach (var persona in PersonaOptions)
                                        {
                                            <option value="@persona.Key">@PersonaStyle(persona)</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>@Text["PlaySpeed"]</span>
                                    <select value="@BotDelaySeconds(playerId).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetBotDelay(playerId, args.Value?.ToString())" aria-label="@Text["PlaySpeed"]">
                                        @foreach (var delay in BotDelayOptions)
                                        {
                                            <option value="@delay.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)">@DelayLabel(delay)</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>@Text["BotSkill"]</span>
                                    <select value="@BotSkill(playerId).ToString()" @onchange="args => SetBotSkill(playerId, args.Value?.ToString())" aria-label="@Text["BotSkill"]">
                                        @foreach (var level in BotSkillOptions)
                                        {
                                            <option value="@level.ToString()">@BotSkillLabel(level)</option>
                                        }
                                    </select>
                                </label>
                            </section>
                        }
                    </div>

                    <div class="setup-modal-actions setup-tab-actions">
                        @if (CanCancelNewGameSetup())
                        {
                            <button class="btn btn-secondary" type="button" @onclick="CancelNewGameSetup">@Text["Cancel"]</button>
                        }
                        <button class="btn btn-primary" type="button" @onclick="StartConfiguredNewGame">@SetupReviewLabel("Да играем", "Let's play")</button>
                    </div>
                </div>
            </section>
        </div>
    }
</main>

@code {
    private const string SaveKey = "ruska-trupa-state-v1";
    private const string CultureKey = "ruska-trupa-culture";
    private const string PersonaStorageKey = "ruska-trupa-personas";
    private const string BotDelayStorageKey = "ruska-trupa-bot-delays";
    private const string BotSkillStorageKey = "ruska-trupa-bot-skills";
    private const string BotNameStorageKey = "ruska-trupa-bot-names";
    private const string HumanNameStorageKey = "ruska-trupa-human-name";
    private const string SetupLockedStorageKey = "ruska-trupa-setup-locked";
    private readonly GameReducer reducer = new();
    private readonly LegalActionProvider legalActions = new();
    private readonly Dictionary<PlayerId, string> personaKeys = new()
    {
        [PlayerId.Second] = "mila",
        [PlayerId.Third] = "georgi"
    };
    private readonly Dictionary<PlayerId, double> botDelaySeconds = new()
    {
        [PlayerId.Second] = 0.5,
        [PlayerId.Third] = 0.5
    };
    private readonly Dictionary<PlayerId, BotSkillLevel> botSkillLevels = new()
    {
        [PlayerId.Second] = BotSkillLevel.Advanced,
        [PlayerId.Third] = BotSkillLevel.Advanced
    };
    private readonly Dictionary<PlayerId, string> botNames = new()
    {
        [PlayerId.Second] = string.Empty,
        [PlayerId.Third] = string.Empty
    };

    private GameState game = GameState.StartNewHand(Environment.TickCount);
    private string humanName = string.Empty;
    private int? bidInput;
    private int? bidInputMinimum;
    private Suit? bidMarriageSuit;
    private string? bidError;
    private ElementReference bidInputElement;
    private int? focusedBidMinimum;
    private IReadOnlyList<Card>? talonExchangePreview;
    private IReadOnlyList<PassCardAction>? pendingBotTalonPasses;
    private int botTalonPreviewStage;
    private MarriageBonusPreview? marriageFlash;
    private MarriageCardPreview? marriageCardPreview;
    private CompletedTrick? tableTrickPreview;
    private bool tableTrickCollecting;
    private bool awaitingTalonExchangeConfirmation;
    private bool awaitingHumanPlayStartConfirmation;
    private bool pendingResignConfirmation;
    private bool isHumanTalonCollecting;
    private bool isHumanTalonCollectingIn;
    private GameState? liveGameBeforeReplay;
    private IReadOnlyList<GameAction> replayActions = Array.Empty<GameAction>();
    private int replayStep;
    private bool triedLoad;
    private bool isReady;
    private bool setupLocked;
    private bool rulesVisible;
    private bool newGameSetupVisible;
    private int setupTabIndex;
    private bool autoPlayHuman;
    private bool skipNextAutoplayDelay;
    private bool isAdvancingBots;
    private bool rerunAdvanceBots;
    private int contractAnimationKey;
    private bool contractAnnouncementAnimating;

    private static IReadOnlyList<PlayerPersona> PersonaOptions { get; } =
    [
        new("mila", "Mila", "\u041c\u0438\u043b\u0430", "Balanced", "\u0411\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u0430\u043d"),
        new("georgi", "Georgi", "\u0413\u0435\u043e\u0440\u0433\u0438", "Bold", "\u0421\u043c\u0435\u043b"),
        new("elena", "Elena", "\u0415\u043b\u0435\u043d\u0430", "Patient", "\u0422\u044a\u0440\u043f\u0435\u043b\u0438\u0432")
    ];

    private static IReadOnlyList<double> BotDelayOptions { get; } = [0.0, 0.5, 1.0, 1.5];
    private static IReadOnlyList<BotSkillLevel> BotSkillOptions { get; } =
        [BotSkillLevel.Beginner, BotSkillLevel.Intermediate, BotSkillLevel.Advanced];

    protected override void OnInitialized()
    {
        _ = AdvanceBotsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !triedLoad)
        {
            triedLoad = true;
            await LoadCultureAsync();
            await LoadPersonasAsync();
            await LoadBotNamesAsync();
            await LoadBotDelaysAsync();
            await LoadBotSkillsAsync();
            await LoadHumanNameAsync();
            await LoadSetupLockedAsync();
            if (!await LoadUnfinishedGameAsync())
            {
                newGameSetupVisible = true;
                setupTabIndex = 0;
            }
            isReady = true;
            StateHasChanged();
            return;
        }

