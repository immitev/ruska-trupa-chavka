    private string SettlementDelta(PlayerId player)
    {
        if (game.Settlement.Kind != SettlementKind.None)
        {
            var settledDelta = game.Settlement.ScoreDeltas[player];
            return settledDelta >= 0 ? $"+{settledDelta}" : settledDelta.ToString();
        }

        var bidderFailed = game.Bidder is not null
            && game.WinningBid is not null
            && game.HandScores[game.Bidder.Value] < game.WinningBid.Value;

        var delta = bidderFailed && game.Bidder == player
            ? -game.WinningBid!.Value
            : game.HandScores[player];

        return delta >= 0 ? $"+{delta}" : delta.ToString();
    }

    private string HandResultClass(PlayerId player)
    {
        if (game.Settlement.Kind == SettlementKind.BidderResigned && game.Settlement.Bidder == player)
        {
            return "failed-bidder";
        }

        if (game.Bidder != player || game.WinningBid is null)
        {
            return string.Empty;
        }

        return game.HandScores[player] < game.WinningBid.Value
            ? "failed-bidder"
            : "successful-bidder";
    }

    private int ContractProgressPercent()
    {
        if (game.Bidder is null || game.WinningBid is null || game.WinningBid.Value <= 0)
        {
            return 0;
        }

        return Math.Clamp(game.HandScores[game.Bidder.Value] * 100 / game.WinningBid.Value, 0, 100);
    }

