    private IReadOnlyList<int> QuickBidOptions()
    {
        var legalAmounts = HumanBidActions()
            .Where(action => action.Amount is not null)
            .Select(action => action.Amount!.Value)
            .ToHashSet();

        var minimum = MinimumHumanBid();
        if (minimum is null or 0)
        {
            return Array.Empty<int>();
        }

        var candidates = new List<int> { minimum.Value };
        if (minimum.Value + 3 < 120)
        {
            candidates.Add(minimum.Value + 3);
        }

        candidates.Add(minimum.Value <= 120 ? 120 : 160);

        return candidates
            .Distinct()
            .Where(legalAmounts.Contains)
            .Take(3)
            .ToArray();
    }

