                "Overtrumping: overtaking is mandatory only when trump is being played. If a trump has been played and you have a higher trump, you must play it. You do not have to overtake in a non-trump suit.",
                "Winning a trick: if any trump is played, the highest trump wins. Otherwise the highest card in the led suit wins. The winner leads the next trick.",
                "Marriage: a K+Q pair in one suit can be announced when the player plays K or Q from that suit. The announcing player does not need to lead the trick. A marriage scores 40 points if it is in the trump suit and 20 points if it is not in the trump suit. In no trump, every marriage scores 20.",
                "Trupa: a defender can ask the other defender for help when they are on turn, can win the current trick, and their partner has not played yet. The partner tries to put in a high-point card.",
                "End of hand: after all tricks, the bidder's points are compared to the bid. If the bidder made the contract, all players score their won points.",
                "Failed bid: if the bidder does not reach the bid, the bid value is subtracted from the bidder, while defenders score their own points.",
                "Resigning: the bidder may resign the hand. The bidder loses the bid value and the two opponents score 25 points each.",
                "End of game: play continues with new deals until a player reaches the target score."
            ];
    }

    private static string RuleTitle(string rule)
    {
        var separator = rule.IndexOf(':');
        return separator > 0 ? rule[..separator] : rule;
    }

    private static string RuleBody(string rule)
    {
        var separator = rule.IndexOf(':');
        return separator > 0 && separator + 1 < rule.Length
            ? rule[(separator + 1)..].TrimStart()
            : string.Empty;
    }

    private string LanguageButtonClass(string culture)
    {
        return Text.CurrentCulture.TwoLetterISOLanguageName == culture
            ? "language-button active"
            : "language-button";
    }

    private async Task SaveAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(SavedGame.FromState(game));
        await Js.InvokeVoidAsync("localStorage.setItem", SaveKey, json);
    }

    private async Task<bool> LoadUnfinishedGameAsync()
    {
        var json = await Js.InvokeAsync<string?>("localStorage.getItem", SaveKey);
        if (string.IsNullOrWhiteSpace(json))
        {
            return false;
        }

        SavedGame? saved;
        GameState restored;
        try
        {
            saved = System.Text.Json.JsonSerializer.Deserialize<SavedGame>(json);
            if (saved is null)
            {
                return false;
            }

            restored = saved.Restore();
        }
        catch
        {
            return false;
        }

        if (saved.Actions.Count == 0 || restored.Phase == GamePhase.GameOver)
        {
            return false;
        }

        game = restored;
        bidInput = null;
        bidInputMinimum = null;
        bidMarriageSuit = null;
        bidError = null;
        talonExchangePreview = null;
        botTalonPreviewStage = 0;
        awaitingTalonExchangeConfirmation = false;
        awaitingHumanPlayStartConfirmation = false;
        pendingResignConfirmation = false;
        marriageFlash = null;
        tableTrickPreview = null;
        tableTrickCollecting = false;
        autoPlayHuman = false;
        skipNextAutoplayDelay = false;
        setupLocked = true;
        await SaveSetupLockedAsync();
        await AdvanceBotsAsync();
        StateHasChanged();
        return true;
    }

    private async Task ClearSaveAsync()
    {
        await Js.InvokeVoidAsync("localStorage.removeItem", SaveKey);
        setupLocked = false;
        bidInput = null;
        bidInputMinimum = null;
        bidMarriageSuit = null;
        bidError = null;
        talonExchangePreview = null;
        botTalonPreviewStage = 0;
        awaitingTalonExchangeConfirmation = false;
        awaitingHumanPlayStartConfirmation = false;
        pendingResignConfirmation = false;
        marriageFlash = null;
        tableTrickPreview = null;
        tableTrickCollecting = false;
        autoPlayHuman = false;
        skipNextAutoplayDelay = false;
        await SaveSetupLockedAsync();
        game = GameState.StartNewHand(Random.Shared.Next());
        await AdvanceBotsAsync();
        StateHasChanged();
    }

