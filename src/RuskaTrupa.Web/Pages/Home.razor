    private async Task ApplyHumanActions(IReadOnlyList<GameAction> actions)
    {
        if (IsReplayMode)
        {
            return;
        }

        if (actions.Count == 1 && actions[0] is ResignHandAction && !pendingResignConfirmation)
        {
            ShowResignConfirmation();
            return;
        }

        if (actions.Count == 1 && actions[0] is RevealTalonAction reveal && reveal.Player == PlayerId.First)
        {
            await RevealHumanTalonAsync(reveal);
            return;
        }

        LockSetup();
        pendingResignConfirmation = false;
        tableTrickPreview = null;
        tableTrickCollecting = false;
        if (!actions.Any(action => action is ChooseTrumpAction or PassCardAction))
        {
            talonExchangePreview = null;
        }
        pendingBotTalonPasses = null;
        botTalonPreviewStage = 0;
        awaitingTalonExchangeConfirmation = false;
        awaitingHumanPlayStartConfirmation = false;
        pendingResignConfirmation = false;
        marriageFlash = null;
        marriageCardPreview = null;

        CompletedTrick? completed = null;
        var announcedMarriage = false;
        var announcedContract = false;
        foreach (var action in actions)
        {
            completed = ApplyAction(action) ?? completed;
            announcedMarriage = announcedMarriage || action is AnnounceMarriageAction;
            announcedContract = announcedContract || action is ChooseTrumpAction;
        }

        if (announcedContract)
        {
            await PlayContractAnnouncementAsync();
        }

        if (announcedMarriage)
        {
            StateHasChanged();
            _ = HoldMarriageCardPreviewAsync();
            await HoldMarriageFlashAsync();
        }

        if (completed is not null)
        {
            await HoldCompletedTrickIfNeededAsync(completed);
        }

        if (ShouldPauseBeforeHumanFirstPlay())
        {
            awaitingHumanPlayStartConfirmation = true;
            StateHasChanged();
            _ = SaveAsync();
            return;
        }

        await AdvanceBotsAsync();
        _ = SaveAsync();
    }

