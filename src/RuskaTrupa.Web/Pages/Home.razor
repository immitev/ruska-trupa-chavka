    private async Task UseHumanCard(Card card)
    {
        if (IsReplayMode)
        {
            return;
        }

        var action = LegalFor(PlayerId.First)
            .FirstOrDefault(action => action is PlayCardAction play && play.Card == card
                || action is PassCardAction pass && pass.Card == card);

        if (awaitingHumanPlayStartConfirmation && action is not PlayCardAction)
        {
            return;
        }

        if (action is not null)
        {
            if (action is PlayCardAction play && MarriageActionFor(card) is { } marriage)
            {
                await ApplyHumanActions([marriage, play]);
                return;
            }

            await ApplyHumanAction(action);
        }
    }

    private async Task AdvanceBotsAsync()
    {
        if (IsReplayMode)
        {
            return;
        }

        if (isAdvancingBots)
        {
            rerunAdvanceBots = true;
            return;
        }

        isAdvancingBots = true;
        try
        {
            do
            {
                rerunAdvanceBots = false;
                await AdvanceBotsCoreAsync();
            }
            while (rerunAdvanceBots && !IsReplayMode);
        }
        finally
        {
            isAdvancingBots = false;
        }
    }

    private async Task AdvanceBotsCoreAsync()
    {
        var guard = 0;
        while (guard++ < 200 && game.Phase != GamePhase.GameOver)
        {
            if (game.Phase == GamePhase.ScoringHand)
            {
                StopHumanAutoplayAtHandResult();
                break;
            }

            var action = ChooseAutomaticAction();
            if (action is null)
            {
                break;
            }

            var actionStamp = CurrentGameStamp();
            if (action is PlayCardAction play)
            {
                var delay = game.GetHand(play.Player).Count <= 1 || skipNextAutoplayDelay
                    ? 0
                    : ActionDelay(BotDelayMilliseconds(play.Player));
                skipNextAutoplayDelay = false;
                if (delay > 0)
                {
                    await Task.Delay(delay);
                }
            }

            if (!IsCurrentGameStamp(actionStamp) || !IsActionStillLegal(action))
            {
                continue;
            }

            if (!autoPlayHuman && action is RevealTalonAction { Player: { } player } reveal && player == PlayerId.First)
            {
                await RevealHumanTalonAsync(reveal, continueAfterReveal: false);
                break;
            }

            if (ShouldPreviewBotTalonPasses(action))
            {
                pendingBotTalonPasses = BuildPendingBotTalonPasses((PassCardAction)action);
                botTalonPreviewStage = 2;
                awaitingTalonExchangeConfirmation = true;
                StateHasChanged();
                break;
            }

            var botActions = ExpandBotAction(action);
            CompletedTrick? completed = null;
            var announcedMarriage = false;
            foreach (var botAction in botActions)
            {
                completed = ApplyAction(botAction) ?? completed;
                announcedMarriage = announcedMarriage || botAction is AnnounceMarriageAction;
            }

            if (announcedMarriage)
            {
                StateHasChanged();
                _ = HoldMarriageCardPreviewAsync();
                await HoldMarriageFlashAsync();
            }

            if (action is RevealTalonAction or PassCardAction)
            {
                StateHasChanged();
                if (action is RevealTalonAction revealAction && revealAction.Player != PlayerId.First)
                {
                    await Task.Delay(ActionDelay(2000));
                    StateHasChanged();
                    continue;
                }

                if (ShouldWaitForTalonExchangeConfirmation(action))
                {
                    botTalonPreviewStage = 2;
                    awaitingTalonExchangeConfirmation = true;
                    StateHasChanged();
                    break;
                }

                await Task.Delay(ActionDelay(1000));
                ClearBotExchangePreview(action);
                StateHasChanged();
            }

            if (action is ChooseTrumpAction chooseTrump && chooseTrump.Player != PlayerId.First && talonExchangePreview is not null)
            {
                botTalonPreviewStage = 1;
                await PlayContractAnnouncementAsync();
                StateHasChanged();
                await Task.Delay(ActionDelay(800));
            }

            if (completed is not null)
            {
                StateHasChanged();
                await HoldCompletedTrickIfNeededAsync(completed);
            }
        }
    }

    private GameAction? ChooseAutomaticAction()
    {
        if (game.Phase == GamePhase.ScoringHand)
        {
            return null;
        }

        if (game.Phase == GamePhase.RevealTalon)
        {
            return LegalFor(game.CurrentPlayer).OfType<RevealTalonAction>().FirstOrDefault();
        }

        return IsAutomaticTurn() ? ChooseBotAction() : null;
    }

    private bool IsActionStillLegal(GameAction action)
    {
