    private bool IsCurrentGameStamp((int InitialSeed, int ActionCount, GamePhase Phase, PlayerId CurrentPlayer) stamp)
    {
        return CurrentGameStamp() == stamp;
    }

    private CompletedTrick? ApplyAction(GameAction action)
    {
        var previousCompletedCount = game.CompletedTricks.Count;
        if (action is RevealTalonAction)
        {
            talonExchangePreview = game.Talon.ToArray();
            pendingBotTalonPasses = null;
            botTalonPreviewStage = 0;
        }
        else if (action is PassCardAction)
        {
        }
        else if (action is not ChooseTrumpAction)
        {
            talonExchangePreview = null;
            pendingBotTalonPasses = null;
            botTalonPreviewStage = 0;
        }

        game = reducer.Apply(game, action);
        if (action is SettleHandAction)
        {
            StopHumanAutoplayAtHandResult();
        }

        if (action is AnnounceMarriageAction marriage)
        {
            var announcement = game.MarriageAnnouncements.LastOrDefault(announcement =>
                announcement.Player == marriage.Player && announcement.Suit == marriage.Suit);
            if (announcement is not null)
            {
                marriageFlash = new MarriageBonusPreview(announcement.Player, announcement.Points);
                marriageCardPreview = new MarriageCardPreview(announcement.Player, announcement.Suit);
            }
        }

        if (game.CompletedTricks.Count > previousCompletedCount)
        {
            tableTrickPreview = game.CompletedTricks[^1];
            return tableTrickPreview;
        }

        return null;
    }

