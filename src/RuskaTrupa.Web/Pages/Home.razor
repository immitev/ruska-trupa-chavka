    private string BidInputValue()
    {
        var minimum = MinimumHumanBid();
        if (minimum is null or 0)
        {
            return string.Empty;
        }

        if (bidInputMinimum != minimum.Value)
        {
            bidInputMinimum = minimum.Value;
            bidInput = minimum.Value;
        }
        else if (bidInput is null)
        {
            bidInput = minimum.Value;
        }

        EnsureBidMarriageSuit();
        return bidInput.Value.ToString();
    }

