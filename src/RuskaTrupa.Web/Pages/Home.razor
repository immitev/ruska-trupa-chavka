    private bool RestoreToPreviousHumanExchangeStep()
    {
        for (var index = game.ActionLog.Count - 1; index >= 0; index--)
        {
            var action = game.ActionLog[index];
            if (action.Player != PlayerId.First)
            {
                continue;
            }

            if (action is PassCardAction or ChooseTrumpAction)
            {
                game = index > 0
                    ? RestoreStateAfterAction(index - 1)
                    : GameState.StartNewHand(game.InitialSeed);
                ResetTransientReviewState();
                return true;
            }
        }

        return false;
    }

    private bool RestoreToLastHumanAction<TAction>()
        where TAction : GameAction
    {
        var actionIndex = -1;
        for (var index = game.ActionLog.Count - 1; index >= 0; index--)
        {
            var action = game.ActionLog[index];
            if (action is TAction && action.Player == PlayerId.First)
            {
                actionIndex = index;
                break;
            }
        }

        if (actionIndex < 0)
        {
            return false;
        }

        game = RestoreStateAfterAction(actionIndex);
        bidInput = null;
        bidInputMinimum = null;
        bidMarriageSuit = null;
        bidError = null;
        marriageFlash = null;
        marriageCardPreview = null;
        tableTrickPreview = null;
        tableTrickCollecting = false;
        autoPlayHuman = false;
        skipNextAutoplayDelay = false;
        return true;
    }

    private void ResetTransientReviewState()
    {
        bidInput = null;
        bidInputMinimum = null;
        bidMarriageSuit = null;
        bidError = null;
        marriageFlash = null;
        marriageCardPreview = null;
        tableTrickPreview = null;
        tableTrickCollecting = false;
        autoPlayHuman = false;
        skipNextAutoplayDelay = false;
    }

    private GameState RestoreStateAfterAction(int actionIndex)
    {
        var state = GameState.StartNewHand(game.InitialSeed);
        foreach (var action in game.ActionLog.Take(actionIndex + 1))
        {
            state = reducer.Apply(state, action);
        }

        return state;
    }

