    private void EnsureBidMarriageSuit()
    {
        if (!BidRequiresMarriageSuit())
        {
            bidMarriageSuit = null;
            return;
        }

        var suits = HumanBidMarriageSuits();
        if (bidMarriageSuit is not null && suits.Contains(bidMarriageSuit.Value))
        {
            return;
        }

        bidMarriageSuit = suits.Count == 1 ? suits[0] : null;
    }

    private void OnBidInputChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var amount))
        {
