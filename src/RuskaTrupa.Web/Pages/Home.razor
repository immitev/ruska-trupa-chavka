    private AnnounceMarriageAction? MarriageActionFor(Card card)
    {
        if (game.Phase != GamePhase.PlayingTricks
            || game.CurrentPlayer != PlayerId.First
            || card.Rank is not (Rank.King or Rank.Queen))
        {
            return null;
        }

        var marriageSuit = card.Suit;
        return LegalFor(PlayerId.First)
            .OfType<AnnounceMarriageAction>()
            .FirstOrDefault(action => action.Suit == marriageSuit);
    }

    private bool IsReplayMode => liveGameBeforeReplay is not null;

    private bool CanStartReplay()
    {
        var range = LatestHandActionRange(game.ActionLog);
        return !IsReplayMode && range.End > range.Start;
    }

    private void StartReplay()
    {
        if (!CanStartReplay())
        {
            return;
        }

        liveGameBeforeReplay = game;
        replayActions = LatestHandReplayActions(liveGameBeforeReplay);
        replayStep = 0;
        SetReplayStep(replayStep);
    }

    private void ExitReplay()
    {
        if (liveGameBeforeReplay is null)
        {
            return;
        }

        game = liveGameBeforeReplay;
        liveGameBeforeReplay = null;
        replayActions = Array.Empty<GameAction>();
        replayStep = 0;
        talonExchangePreview = null;
        botTalonPreviewStage = 0;
        awaitingTalonExchangeConfirmation = false;
        awaitingHumanPlayStartConfirmation = false;
        pendingResignConfirmation = false;
        marriageFlash = null;
        marriageCardPreview = null;
        tableTrickPreview = null;
        tableTrickCollecting = false;
    }

    private void PreviousReplayStep()
    {
        SetReplayStep(Math.Max(0, replayStep - 1));
    }

    private void NextReplayStep()
    {
        SetReplayStep(Math.Min(replayActions.Count, replayStep + 1));
    }

    private void SetReplayStep(int step)
    {
        if (liveGameBeforeReplay is null)
        {
            return;
        }

        replayStep = Math.Clamp(step, 0, replayActions.Count);
        game = RestoreReplayState(liveGameBeforeReplay, replayStep);
        talonExchangePreview = null;
        botTalonPreviewStage = 0;
        awaitingTalonExchangeConfirmation = false;
        awaitingHumanPlayStartConfirmation = false;
        pendingResignConfirmation = false;
        marriageFlash = null;
        tableTrickPreview = ReplayTableTrickPreview();
    }

    private CompletedTrick? ReplayTableTrickPreview()
    {
        if (!IsReplayMode || replayStep <= 0 || replayStep > replayActions.Count)
        {
            return null;
        }

        return replayActions[replayStep - 1] is PlayCardAction && game.CurrentTrick.Count == 0
            ? game.CompletedTricks.LastOrDefault()
            : null;
    }

    private GameState RestoreReplayState(GameState source, int handStep)
    {
        var (segmentStart, _) = LatestHandActionRange(source.ActionLog);
        var actionLimit = segmentStart + handStep;
        var state = GameState.StartNewHand(source.InitialSeed);

        foreach (var action in source.ActionLog.Take(actionLimit))
        {
            state = reducer.Apply(state, action);
        }

        return state;
    }

    private static IReadOnlyList<GameAction> LatestHandReplayActions(GameState source)
    {
        var range = LatestHandActionRange(source.ActionLog);
        return source.ActionLog
            .Skip(range.Start)
            .Take(range.End - range.Start)
            .ToArray();
    }

    private static (int Start, int End) LatestHandActionRange(IReadOnlyList<GameAction> actions)
    {
        var end = actions.Count;
        if (end > 0 && actions[end - 1] is SettleHandAction)
        {
            end--;
        }

        for (var index = end - 1; index >= 0; index--)
        {
            if (actions[index] is SettleHandAction)
            {
                return (index + 1, end);
            }
        }

        return (0, end);
    }

    private async Task HoldCompletedTrickIfNeededAsync(CompletedTrick completed)
    {
        await Task.Delay(ActionDelay(650));
        if (ReferenceEquals(tableTrickPreview, completed) || tableTrickPreview == completed)
        {
            tableTrickCollecting = true;
            StateHasChanged();
            await Task.Delay(ActionDelay(520));
        }

        if (ReferenceEquals(tableTrickPreview, completed) || tableTrickPreview == completed)
        {
            tableTrickPreview = null;
            tableTrickCollecting = false;
            StateHasChanged();
        }
    }

    private bool IsAutomaticTurn()
    {
        if (game.Phase == GamePhase.ScoringHand)
        {
            return autoPlayHuman;
        }

        if (game.Phase == GamePhase.Bidding)
        {
            return game.Players.Single(player => player.Id == game.CurrentPlayer).Kind == PlayerKind.Bot;
        }

        return game.Players.Single(player => player.Id == game.CurrentPlayer).Kind == PlayerKind.Bot
            || autoPlayHuman && game.CurrentPlayer == PlayerId.First;
    }

    private GameAction? ChooseBotAction()
    {
        var current = game.CurrentPlayer;
        var legal = LegalFor(current);

        return game.Phase switch
        {
            GamePhase.Bidding => ChooseBotBid(current, legal.OfType<BidAction>().ToArray()),
            GamePhase.RevealTalon => legal.OfType<RevealTalonAction>().FirstOrDefault(),
            GamePhase.ChooseTrump => ChooseBotTrump(current, legal.OfType<ChooseTrumpAction>().ToArray()),
            GamePhase.PassCards => ChooseBotPass(current, legal.OfType<PassCardAction>().ToArray()),
            GamePhase.PlayingTricks => ChooseBotPlayingAction(current, legal),
            GamePhase.ScoringHand => legal.OfType<SettleHandAction>().FirstOrDefault(),
            _ => null
        };
    }

    private GameAction ChooseBotBid(PlayerId player, IReadOnlyList<BidAction> legal)
    {
        var legalAmounts = legal.Select(action => action.Amount ?? 0).ToArray();
        var decision = BotFor(player).DecideOpeningBid(game.CreateObservation(player), legalAmounts);
        return legal.FirstOrDefault(action => action.Amount == decision.Action || action.Amount is null && decision.Action == 0)
            ?? legal.OrderBy(action => action.Amount ?? int.MaxValue).First();
    }

    private GameAction ChooseBotTrump(PlayerId player, IReadOnlyList<ChooseTrumpAction> legal)
    {
        var decision = BotFor(player).DecideTrump(game.CreateObservation(player), legal.Select(action => action.Trump).ToArray());
        return legal.First(action => action.Trump == decision.Action);
    }

    private GameAction ChooseBotPass(PlayerId player, IReadOnlyList<PassCardAction> legal)
    {
        var decision = BotFor(player).DecideCardToPass(game.CreateObservation(player), legal.Select(action => action.Card).ToArray());
        return legal.First(action => action.Card == decision.Action);
    }

    private GameAction ChooseBotPlayingAction(PlayerId player, IReadOnlyList<GameAction> legal)
    {
        if (ShouldSignalTrupa(player, legal) is { } trupa)
        {
            return trupa;
        }

        var legalPlayActions = legal.OfType<PlayCardAction>().ToArray();
        if (ShouldHonorTrupaSignal(player))
        {
            return legalPlayActions
                .OrderByDescending(action => action.Card.PointValue)
                .ThenByDescending(action => action.Card.Strength)
                .First();
        }

        var legalPlays = legalPlayActions.Select(action => action.Card).ToArray();
        var decision = BotFor(player).DecideCard(game.CreateObservation(player), legalPlays);
        return legalPlayActions.First(action => action.Card == decision.Action);
    }

    private SignalTrupaAction? ShouldSignalTrupa(PlayerId player, IReadOnlyList<GameAction> legal)
    {
        if (game.Bidder is null || game.Bidder == player || BotSkill(player) == BotSkillLevel.Beginner)
        {
            return null;
        }

        var signal = legal.OfType<SignalTrupaAction>().FirstOrDefault();
        if (signal is null)
        {
            return null;
        }

        var trickPoints = game.CurrentTrick.Sum(played => played.Card.PointValue);
        var partner = PlayerOrder.All.Single(candidate => candidate != player && candidate != game.Bidder.Value);
        var partnerHasPoints = game.GetHand(partner).Any(card => card.PointValue >= 10);
        return BotSkill(player) == BotSkillLevel.Intermediate
            ? trickPoints >= 15 ? signal : null
            : trickPoints >= 10 || partnerHasPoints ? signal : null;
    }

