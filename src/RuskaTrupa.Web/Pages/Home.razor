    private bool ShouldPreviewBotTalonPasses(GameAction action)
    {
        return !autoPlayHuman
            && action is PassCardAction pass
            && pass.Player != PlayerId.First
            && game.Phase == GamePhase.PassCards
            && talonExchangePreview is not null
            && pendingBotTalonPasses is null;
    }

    private IReadOnlyList<PassCardAction> BuildPendingBotTalonPasses(PassCardAction firstPass)
    {
        var passes = new List<PassCardAction> { firstPass };
        var previewState = reducer.Apply(game, firstPass);
        while (previewState.Phase == GamePhase.PassCards && passes.Count < 2)
        {
            var legal = legalActions.GetLegalActions(previewState, previewState.CurrentPlayer).OfType<PassCardAction>().ToArray();
            if (legal.Length == 0)
            {
                break;
            }

            var observation = previewState.CreateObservation(previewState.CurrentPlayer);
            var decision = BotFor(previewState.CurrentPlayer).DecideCardToPass(observation, legal.Select(action => action.Card).ToArray());
            var next = legal.FirstOrDefault(action => action.Card == decision.Action) ?? legal[0];
            passes.Add(next);
            previewState = reducer.Apply(previewState, next);
        }

        return passes;
    }

