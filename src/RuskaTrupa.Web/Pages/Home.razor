    }

    private async Task LoadPersonasAsync()
    {
        var json = await Js.InvokeAsync<string?>("localStorage.getItem", PersonaStorageKey);
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }

        var saved = System.Text.Json.JsonSerializer.Deserialize<Dictionary<PlayerId, string>>(json);
        if (saved is null)
        {
            return;
        }

        foreach (var (player, key) in saved)
        {
            if (PersonaOptions.Any(persona => persona.Key == key))
            {
                personaKeys[player] = key;
            }
        }
    }

    private async Task SaveBotNamesAsync()
